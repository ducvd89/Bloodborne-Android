From: bbport
Subject: [PATCH] Frame generation: free per-frame descriptor pools and constant buffers

The frame generation context shares the bridge with the upscaler code but
never called BridgeBeginFrame or BridgeRetireFrame. The descriptor
sets and constant buffers were tagged frame 0 and never freed: one descriptor
pool and buffer per job. On Turnip each is a mapped KGSL buffer, so the
process reached the 65530 mapping limit within two minutes of frame
generation (vkMapMemory failed, then crashes).
---
diff --git a/src/ffx_vk_fsr3_3_1_6_framegen.cpp b/src/ffx_vk_fsr3_3_1_6_framegen.cpp
index 9636cec..9519369 100644
--- a/src/ffx_vk_fsr3_3_1_6_framegen.cpp
+++ b/src/ffx_vk_fsr3_3_1_6_framegen.cpp
@@ -463,6 +463,10 @@ ffxVkFsr3_3_1_6FrameGenerationContextRecordPrepare(
         !valid_image(info->depth, VK_FORMAT_R32_SFLOAT, info->renderWidth, info->renderHeight, false) ||
         !valid_motion_image(info->motionVectors, info->renderWidth, info->renderHeight))
         return FFX_VK_FSR3_3_1_6_FRAMEGEN_ERROR_INVALID_ARGUMENT;
+    /* The descriptor sets and constant buffers the bridge makes for this
+     * frame's jobs are tagged with its id and freed by RetireFrame; untagged
+     * (frame 0) they were never freed, one descriptor pool and buffer per job. */
+    ffxVkFsr3_3_1_5BridgeBeginFrame(context->bridge, info->frameId);
     if (!context->initialized) {
         const OwnedSharedImage shared[] = {
             context->opticalFlowVector, context->opticalFlowScd, context->dilatedDepth,
@@ -676,6 +680,7 @@ ffxVkFsr3_3_1_6FrameGenerationContextRetireFrame(
             ++retained;
         }
     }
+    ffxVkFsr3_3_1_5BridgeRetireFrame(context->bridge, completedFrameId);
     return FFX_VK_FSR3_3_1_6_FRAMEGEN_OK;
 }
 
