# The Linux build of the Rebuild Tool is compiled and linked against an Ubuntu 22.04 sysroot (glibc 2.35, libstdc++ 12;
# fetch-sysroot.py), with clang and lld of the official LLVM tarball (fetch-deps.sh), so that it runs on any distribution with
# glibc 2.35 or newer. libstdc++ and libgcc are linked statically; only glibc (and the X11/Wayland/GL libraries SDL loads at run time)
# come from the user's system.
#   cmake -DCMAKE_TOOLCHAIN_FILE=tools/recomp/linux-jammy-toolchain.cmake -DBB_SYSROOT=<sysroot> -DBB_LLVM_ROOT=<llvm tarball dir> ...
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
foreach(v BB_SYSROOT BB_LLVM_ROOT)
  if(NOT ${v})
    set(${v} "$ENV{${v}}")
  endif()
endforeach()
set(CMAKE_SYSROOT "${BB_SYSROOT}")
set(CMAKE_C_COMPILER "${BB_LLVM_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${BB_LLVM_ROOT}/bin/clang++")
set(_gcc "${BB_SYSROOT}/usr/lib/gcc/x86_64-linux-gnu/12")
set(_common "--gcc-install-dir=${_gcc} -fuse-ld=lld")
set(CMAKE_C_FLAGS_INIT "${_common}")
set(CMAKE_CXX_FLAGS_INIT "${_common} -stdlib=libstdc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
set(CMAKE_FIND_ROOT_PATH "${BB_SYSROOT}")
# pkg-config sees the sysroot's .pc files only (not the build machine's libraries)
set(ENV{PKG_CONFIG_LIBDIR} "${BB_SYSROOT}/usr/lib/x86_64-linux-gnu/pkgconfig:${BB_SYSROOT}/usr/share/pkgconfig:${BB_SYSROOT}/usr/lib/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${BB_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
if(BB_RECOMP_DEPS_PREFIX)
  list(APPEND CMAKE_FIND_ROOT_PATH "${BB_RECOMP_DEPS_PREFIX}")
endif()
if(BB_RECOMP_SDL_PREFIX)
  list(APPEND CMAKE_FIND_ROOT_PATH "${BB_RECOMP_SDL_PREFIX}")
endif()
