diff --git a/framegen/src/core/zeroimage.cpp b/framegen/src/core/zeroimage.cpp
new file mode 100644
index 0000000..804cc68
--- /dev/null
+++ b/framegen/src/core/zeroimage.cpp
@@ -0,0 +1,58 @@
+#include <volk.h>
+#include <vulkan/vulkan_core.h>
+
+#include "core/device.hpp"
+#include "core/image.hpp"
+#include "core/commandpool.hpp"
+#include "core/commandbuffer.hpp"
+#include "core/fence.hpp"
+#include "common/exception.hpp"
+
+#include <memory>
+
+using namespace LSFG::Core;
+
+const Image& Device::getZeroImage() const {
+    if (*this->zeroImage)
+        return **this->zeroImage;
+
+    auto image = std::make_shared<Image>(*this, VkExtent2D{ 1, 1 }, VK_FORMAT_R16G16B16A16_SFLOAT,
+        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        VK_IMAGE_ASPECT_COLOR_BIT);
+
+    const CommandPool pool(*this);
+    CommandBuffer cmd(*this, pool);
+    cmd.begin();
+    const VkImageSubresourceRange range{ .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .levelCount = 1, .layerCount = 1 };
+    VkImageMemoryBarrier2 barrier{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+        .dstStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT,
+        .dstAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+        .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+        .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+        .image = image->handle(),
+        .subresourceRange = range
+    };
+    VkDependencyInfo dependency{ .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &barrier };
+    vkCmdPipelineBarrier2(cmd.handle(), &dependency);
+    const VkClearColorValue zero{};
+    vkCmdClearColorImage(cmd.handle(), image->handle(), VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &range);
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    vkCmdPipelineBarrier2(cmd.handle(), &dependency);
+    cmd.end();
+
+    const Fence fence(*this);
+    cmd.submit(this->getComputeQueue(), fence);
+    if (!fence.wait(*this))
+        throw LSFG::vulkan_error(VK_TIMEOUT, "Failed to clear the zero image");
+
+    image->setLayout(VK_IMAGE_LAYOUT_GENERAL);
+    *this->zeroImage = image;
+    return *image;
+}
