+
+int Semaphore::exportSyncFd(const Core::Device& device) const {
+    auto vkGetSemaphoreFdKHR = reinterpret_cast<PFN_vkGetSemaphoreFdKHR>(
+        vkGetDeviceProcAddr(device.handle(), "vkGetSemaphoreFdKHR"));
+    const VkSemaphoreGetFdInfoKHR fdInfo{
+        .sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
+        .semaphore = this->handle(),
+        .handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT
+    };
+    int fd{-1};
+    auto res = vkGetSemaphoreFdKHR(device.handle(), &fdInfo, &fd);
+    if (res != VK_SUCCESS)
+        throw LSFG::vulkan_error(res, "Unable to export semaphore to sync fd");
+    return fd;
+}
