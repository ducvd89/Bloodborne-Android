+
+int Semaphore::exportSyncFd(VkDevice device) const {
+    const VkSemaphoreGetFdInfoKHR fdInfo{
+        .sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
+        .semaphore = this->handle(),
+        .handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT
+    };
+    int fd{-1};
+    auto res = Layer::ovkGetSemaphoreFdKHR(device, &fdInfo, &fd);
+    if (res != VK_SUCCESS)
+        throw LSFG::vulkan_error(res, "Unable to export semaphore to sync fd");
+    return fd;
+}
+
+void Semaphore::importSyncFd(VkDevice device, int fd) const {
+    const VkImportSemaphoreFdInfoKHR importInfo{
+        .sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_FD_INFO_KHR,
+        .semaphore = this->handle(),
+        .flags = VK_SEMAPHORE_IMPORT_TEMPORARY_BIT,
+        .handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT,
+        .fd = fd // closes the fd
+    };
+    auto res = Layer::ovkImportSemaphoreFdKHR(device, &importInfo);
+    if (res != VK_SUCCESS)
+        throw LSFG::vulkan_error(res, "Unable to import semaphore from sync fd");
+}
