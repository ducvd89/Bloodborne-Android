       result = VK_ERROR_SURFACE_LOST_KHR;
    }
@@ -2984,6 +3231,11 @@
       wsi_queue_destroy(&chain->acquire_queue);
    wsi_queue_destroy(&chain->present_queue);
 
+   if (chain->fxpresent) {
+      fxpresent_close(chain->fxpresent);
+      vk_free(pAllocator, chain->fxpresent);
+   }
+
    for (uint32_t i = 0; i < chain->base.image_count; i++)
       x11_image_finish(chain, pAllocator, &chain->images[i]);
 #ifdef HAVE_X11_DRM
@@ -3277,6 +3529,13 @@
    chain->has_dri3_modifiers = wsi_conn->has_dri3_modifiers;
    chain->has_mit_shm = wsi_conn->has_mit_shm;
    chain->base.sw_fence_wait_in_backend = chain->base.wsi->sw;
+   /* fexdroid: frames straight to the app, when it asks for them. */
+   if (chain->base.wsi->sw && !chain->has_mit_shm && os_get_option("FEXDROID_PRESENT")) {
+      chain->fxpresent = vk_zalloc(pAllocator, sizeof(*chain->fxpresent), 8,
